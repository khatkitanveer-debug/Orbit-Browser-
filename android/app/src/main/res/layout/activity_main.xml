<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chrome_bg">

    <!-- v1.8.0 toolbar: [omnibox pill (site par)][3-dot menu] — baaki sab hata -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="@color/chrome_bg">

        <!-- Omnibox pill: lock + URL + reload (Chrome jaisa reload pill ke andar).
             v1.6.0 — newtab (home screen) par YE PILL HIDE hoti hai (user request:
             upar wala search bar remove — middle search bar already hai), jagah par
             Orbit brand text dikhta hai. Site par navigate karte hi pill wapas. -->
        <FrameLayout
            android:id="@+id/omni_pill"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/omnibox_bg">

            <ImageView
                android:id="@+id/omni_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/chrome_text_dim"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/omnibox"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:paddingStart="34dp"
                android:paddingEnd="44dp"
                android:textSize="14sp"
                android:textColor="@color/chrome_text"
                android:textColorHint="@color/chrome_text_dim"
                android:hint="@string/search_hint"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <!-- Bookmark star (Chrome parity): tap = current page bookmark save/remove -->
            <ImageButton
                android:id="@+id/btn_star"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="38dp"
                android:background="@drawable/btn_ripple"
                android:src="@drawable/ic_star"
                android:contentDescription="@string/bookmark"
                android:tint="@color/chrome_text_dim"
                android:visibility="gone" />
            <TextView
                android:id="@+id/shield_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="44dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#81C995"
                android:visibility="gone"
                android:text="🛡 0" />

            <!-- v1.8.0 — reload button REMOVE (user request: header me reload nahi).
                 Reload ab pull-to-refresh se hota hai. Niche wala clear X (typing
                 mode) abhi bhi hai — wo address text saaf karta hai. -->

            <!-- v1.3.5 — omnibox focus-mode clear (X): typing ke waqt reload ki
                 jagah X dikhta hai, text saaf karte hi icons wapas -->
            <ImageButton
                android:id="@+id/btn_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="5dp"
                android:background="@drawable/btn_ripple"
                android:src="@drawable/ic_close"
                android:contentDescription="Clear"
                android:tint="@color/chrome_text_dim"
                android:visibility="gone" />
        </FrameLayout>

        <!-- v1.8.0 — HEADER CLEAN (user request: upar header me Orbit logo, home
             button, reload button, tab-count — SAB REMOVE). Ab toolbar me sirf
             site pages par [omnibox pill] + hamesha [3-dot menu] dikhta hai.
             Home/Tabs/reload menu ke through milte hai. Home screen par pill bhi
             hidden hai (v1.6.0) — to header = sirf menu, content full-bleed. -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_ripple"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/menu"
            android:tint="@color/chrome_text" />
    </LinearLayout>

    <!-- v1.4.1 — blue loading line REMOVED: ab omnibox ke andar Orbit ring loader hai -->

    <!-- Find in page bar (Chrome jaisa, toolbar ke neeche) -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/chrome_surface"
        android:visibility="gone">

        <EditText
            android:id="@+id/find_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:background="@drawable/omnibox_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp"
            android:textColor="@color/chrome_text"
            android:textColorHint="@color/chrome_text_dim"
            android:hint="@string/find_in_page"
            android:inputType="text"
            android:imeOptions="actionGo"
            android:maxLines="1" />

        <TextView
            android:id="@+id/find_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/chrome_text_dim"
            android:text="0/0" />

        <ImageButton
            android:id="@+id/find_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_ripple"
            android:src="@drawable/ic_up"
            android:tint="@color/chrome_text"
            android:contentDescription="Previous match" />

        <ImageButton
            android:id="@+id/find_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_ripple"
            android:src="@drawable/ic_down"
            android:tint="@color/chrome_text"
            android:contentDescription="Next match" />

        <ImageButton
            android:id="@+id/find_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_ripple"
            android:src="@drawable/ic_close"
            android:tint="@color/chrome_text"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Content + Chrome pull-to-refresh -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/pull_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- v1.7.0 — Orbit LINE loader TOOLBAR KE NEECHE (user request: round ring
             nahi, lambi line + orbit comet-dot animation). Full-width thin line:
             track + blue gradient fill + glowing comet tip + trailing dots. -->
        <FrameLayout
            android:id="@+id/ring_wrap"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top"
            android:elevation="14dp"
            android:visibility="gone">

            <com.orbit.browser.OrbitLineLoader
                android:id="@+id/ring_loader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>

    <!-- v1.4.4 — Chrome-style DOWNLOAD BAR: download start hote hi bottom par
         dikhta hai — file name + real-time speed/ETA (UC style) + progress line.
         Tap = Downloads page. Pause/resume X-button se. -->
    <FrameLayout
        android:id="@+id/download_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/chrome_surface"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/dl_prog"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:progressTint="@color/chrome_blue"
            android:progressBackgroundTint="#3C4043"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/dl_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_download"
                android:tint="@color/chrome_blue"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dl_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/chrome_text"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />

                <TextView
                    android:id="@+id/dl_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/chrome_text_dim"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dl_act"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_ripple"
                android:src="@drawable/ic_pause"
                android:contentDescription="Pause"
                android:tint="@color/chrome_text" />
        </LinearLayout>
    </FrameLayout>

    <!-- Chrome tab switcher: cards grid + FAB -->
    <FrameLayout
        android:id="@+id/tab_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chrome_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/switcher_title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/chrome_text"
                    android:text="Tabs" />

                <TextView
                    android:id="@+id/btn_close_all"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/btn_ripple"
                    android:textSize="14sp"
                    android:textColor="@color/chrome_blue"
                    android:text="@string/close_all" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <GridLayout
                    android:id="@+id/switcher_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="90dp" />
            </ScrollView>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_new_tab_fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/fab_bg"
            android:src="@drawable/ic_newtab"
            android:tint="@color/chrome_text"
            android:contentDescription="@string/tabs" />
    </FrameLayout>
</LinearLayout>
