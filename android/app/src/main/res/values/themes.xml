<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orbit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/orbit_black</item>
        <item name="android:statusBarColor">@color/orbit_black</item>
        <item name="android:navigationBarColor">@color/orbit_black</item>
        <item name="android:colorAccent">@color/orbit_white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="OrbitDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/orbit_white</item>
    </style>

    <!-- Chrome-jaisa 3-dot menu — top-right se slide + fade hoke khulta hai -->
    <style name="OrbitPopupAnim">
        <item name="android:windowEnterAnimation">@anim/menu_in</item>
        <item name="android:windowExitAnimation">@anim/menu_out</item>
    </style>
</resources>
